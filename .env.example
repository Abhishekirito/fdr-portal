# ==========================================
# AICTE Security Deposit & FDR Portal - Environment Config
# ==========================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-client

# AI Microservice URL (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# LLM & OCR API Keys
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_OCR_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=your-anthropic-api-key
RESEND_API_KEY=your-resend-api-key
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token

# Digital Signing (Public/Private Key Pair for Release NOC Certificates)
CERT_SIGNING_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0...SAMPLE...\n-----END RSA PRIVATE KEY-----"
NEXT_PUBLIC_CERT_VERIFY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----"

# Production deployment mode (demo shortcuts disabled by default)
NEXT_PUBLIC_DEMO_MODE=false
